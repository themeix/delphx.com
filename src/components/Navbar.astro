---
const navItems = [
  { num: '01', label: 'Home', href: '/' },
  { num: '02', label: 'About', href: '/about' },
  { num: '03', label: 'Investors', href: '/investors' },
  { num: '04', label: 'Team', href: '/team' },
  { num: '05', label: 'Press Releases', href: '/press-releases' },
  { num: '06', label: 'Media Resources', href: '/resources' },
];

const allNavItems = [
  ...navItems,
  { num: '07', label: 'Contact', href: '/contact' },
];

const currentPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
---

<header id="Nav" transition:persist class="fixed top-0 inset-x-0 z-50 bg-off-white/95 backdrop-blur-xl border-b border-neutral-200/75">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12 h-[76px] md:h-[84px] flex items-center justify-between gap-8">
    <!-- Left: Larger Brand Logo (no hover scale) -->
    <a href="/" class="inline-flex items-center shrink-0 focus:outline-none" aria-label="DelphX Home">
      <img
        src="/images/6815dd83de9cfb24c5c23d0f_logo.svg"
        alt="DelphX Capital Markets"
        width="180"
        height="46"
        class="h-10 sm:h-11 md:h-12 w-auto"
      />
    </a>

    <!-- Center: Clean Editorial Navigation (larger font, no numbers, animated purple underline) -->
    <nav class="hidden lg:flex items-center gap-7 xl:gap-9" aria-label="Primary Navigation">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class:list={[
              'group relative py-2 inline-flex items-center text-[15px] xl:text-[15.5px] font-medium transition-colors duration-200 whitespace-nowrap',
              isActive ? 'text-deep-purple' : 'text-neutral-600 hover:text-deep-purple'
            ]}
          >
            <span>{item.label}</span>
            <span
              class:list={[
                'absolute left-0 right-0 -bottom-[1px] h-[2px] rounded-full bg-purple origin-left transition-transform duration-300 ease-out',
                isActive ? 'scale-x-100' : 'scale-x-0 group-hover:scale-x-100'
              ]}
            ></span>
          </a>
        );
      })}
    </nav>

    <!-- Right: Distinct Contact CTA Button (Desktop) -->
    <div class="hidden lg:flex items-center shrink-0">
      <a
        href="/contact"
        class:list={[
          'group inline-flex items-center gap-2.5 px-6 py-2.5 rounded-full text-[13px] font-medium tracking-wide border transition-colors duration-200 whitespace-nowrap',
          currentPath === '/contact'
            ? 'bg-purple border-purple text-white'
            : 'bg-deep-purple border-deep-purple text-white hover:bg-purple hover:border-purple'
        ]}
      >
        <span>Contact</span>
        <svg
          class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>

    <!-- Mobile / Tablet Only Hamburger Button -->
    <button
      type="button"
      id="menu-toggle-btn"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="nav-drawer"
      class="lg:hidden w-11 h-11 rounded-full border border-neutral-300 bg-white hover:border-deep-purple flex flex-col items-center justify-center gap-1.5 transition-colors cursor-pointer"
    >
      <span id="menu-line-top" class="block w-4 h-[1.5px] bg-deep-purple transition-transform duration-300"></span>
      <span id="menu-line-bottom" class="block w-4 h-[1.5px] bg-deep-purple transition-transform duration-300"></span>
    </button>
  </div>

  <!-- Mobile / Tablet Full-Screen Numbered Drawer -->
  <div
    id="nav-drawer"
    class="lg:hidden fixed inset-0 top-[76px] md:top-[84px] z-40 bg-deep-purple text-white opacity-0 pointer-events-none transition-opacity duration-300 overflow-y-auto"
    aria-hidden="true"
  >
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 py-10 flex flex-col justify-between min-h-[calc(100vh-76px)]">
      <div class="grid grid-cols-1 gap-2">
        {allNavItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class="group flex items-baseline gap-4 py-3.5 border-b border-white/10 hover:border-lavender/60 transition-colors"
            >
              <span class="font-sans font-medium text-sm text-lavender/80 group-hover:text-lavender transition-colors">
                {item.num}.
              </span>
              <span
                class:list={[
                  'font-display text-3xl sm:text-4xl font-medium tracking-tight transition-transform duration-300 group-hover:translate-x-2',
                  isActive ? 'text-lavender' : 'text-white'
                ]}
              >
                {item.label}
              </span>
            </a>
          );
        })}
      </div>

      <div class="pt-10 flex flex-col sm:flex-row sm:items-center justify-between gap-4 text-sm text-white/70 font-sans font-medium">
        <div>Miami • New York • Toronto</div>
        <div class="flex items-center gap-6">
          <a href="/privacy-policy" class="hover:text-white transition-colors">Privacy</a>
          <a href="/terms-and-conditions" class="hover:text-white transition-colors">Terms</a>
          <a href="https://www.linkedin.com/company/59469860/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
            LinkedIn
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('menu-toggle-btn');
    var drawer = document.getElementById('nav-drawer');
    var topLine = document.getElementById('menu-line-top');
    var bottomLine = document.getElementById('menu-line-bottom');
    if (!btn || !drawer || !topLine || !bottomLine) return;

    var isOpen = false;
    function setOpen(open) {
      isOpen = open;
      btn.setAttribute('aria-expanded', String(open));
      drawer.setAttribute('aria-hidden', String(!open));
      if (open) {
        drawer.classList.remove('opacity-0', 'pointer-events-none');
        drawer.classList.add('opacity-100', 'pointer-events-auto');
        topLine.style.transform = 'translateY(3.75px) rotate(45deg)';
        bottomLine.style.transform = 'translateY(-3.75px) rotate(-45deg)';
        document.body.style.overflow = 'hidden';
      } else {
        drawer.classList.add('opacity-0', 'pointer-events-none');
        drawer.classList.remove('opacity-100', 'pointer-events-auto');
        topLine.style.transform = '';
        bottomLine.style.transform = '';
        document.body.style.overflow = '';
      }
    }

    btn.addEventListener('click', function () {
      setOpen(!isOpen);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && isOpen) setOpen(false);
    });

    // Sync active state & close mobile drawer on persisted ClientRouter navigation
    document.addEventListener('astro:page-load', function () {
      if (isOpen) setOpen(false);
      var path = window.location.pathname === '/' ? '/' : window.location.pathname.replace(/\/$/, '');
      document.querySelectorAll('#Nav nav a').forEach(function (link) {
        var href = link.getAttribute('href') || '/';
        var active = path === href || (href !== '/' && path.startsWith(href));
        var underline = link.querySelector('span:last-child');
        if (active) {
          link.classList.remove('text-neutral-600');
          link.classList.add('text-deep-purple');
          if (underline) {
            underline.classList.remove('scale-x-0');
            underline.classList.add('scale-x-100');
          }
        } else {
          link.classList.add('text-neutral-600');
          link.classList.remove('text-deep-purple');
          if (underline) {
            underline.classList.add('scale-x-0');
            underline.classList.remove('scale-x-100');
          }
        }
      });
    });
  })();
</script>
