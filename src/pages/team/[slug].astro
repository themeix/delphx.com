---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LetsConnect from '../../components/LetsConnect.astro';
import teamMembers from '../../data/team.json';

export function getStaticPaths() {
  return teamMembers.map((member) => ({
    params: { slug: member.slug },
    props: { member },
  }));
}

const { member } = Astro.props;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: member.name,
  jobTitle: member.role,
  worksFor: {
    '@type': 'Organization',
    name: 'DelphX Capital Markets Inc.',
    url: 'https://www.delphx.com',
  },
  url: `https://www.delphx.com/team/${member.slug}`,
  ...(member.image ? { image: `https://www.delphx.com${member.image}` } : {}),
};
---

<BaseLayout
  title={`${member.name} | DelphX Capital Markets`}
  description={`${member.name} - ${member.role} at DelphX Capital Markets Inc.`}
  canonicalPath={`/team/${member.slug}`}
  image={member.image || undefined}
  schema={personSchema}
>
  <section class="bg-off-white pt-16 sm:pt-24 pb-20">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      <div class="mb-8">
        <a
          href="/team"
          class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-purple hover:text-deep-purple transition-colors"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          <span>View All</span>
        </a>
      </div>

      {member.image ? (
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
          <div class="lg:col-span-4">
            <div class="rounded-2xl overflow-hidden bg-deep-purple aspect-[4/5] border border-neutral-200">
              <img
                src={member.image}
                alt={member.name}
                class="w-full h-full object-cover object-top"
              />
            </div>
          </div>

          <div class="lg:col-span-8 space-y-6">
            <div class="border-b border-neutral-200 pb-6">
              <h1 class="font-display text-4xl sm:text-5xl font-bold text-deep-purple">{member.name}</h1>
              <p class="mt-2 font-mono text-sm sm:text-base text-purple uppercase tracking-wider">{member.role}</p>
            </div>

            <div class="rich-text" set:html={member.bioHtml} />
          </div>
        </div>
      ) : (
        <div class="max-w-4xl space-y-6">
          <div class="border-b border-neutral-200 pb-6">
            <h1 class="font-display text-4xl sm:text-5xl font-bold text-deep-purple">{member.name}</h1>
            <p class="mt-2 font-mono text-sm sm:text-base text-purple uppercase tracking-wider">{member.role}</p>
          </div>

          <div class="rich-text" set:html={member.bioHtml} />
        </div>
      )}
    </div>
  </section>

  <LetsConnect />
</BaseLayout>
