---

<BaseLayout
  title="Company Financials | DelphX Capital Markets"
  description="Quarterly and annual financial statements and Management's Discussion and Analysis (MD&A) for DelphX Capital Markets Inc. from 2018 to 2025."
  canonicalPath="/company-financials"
>
  <section class="bg-off-white pt-12 sm:pt-16 pb-12 sm:pb-16 border-b border-neutral-200">
    <div data-page-header class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      <div class="flex items-center gap-3 mb-6">
        <img src="/images/68121fa3c12b45a8493f881a_Quad.svg" alt="" width="24" height="24" class="w-6 h-6" />
        <span class="font-mono text-xs uppercase tracking-widest text-purple">Filings &amp; Reports</span>
      </div>
      <h1 class="font-display text-4xl sm:text-6xl font-bold text-deep-purple tracking-tight">
        Company Financials
      </h1>
    </div>
  </section>

  <section class="bg-off-white py-16 md:py-24">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12 space-y-12">
      {yearlyGroups.map((group) => (
        <div class="space-y-6">
          <h2 class="font-display text-2xl sm:text-3xl font-semibold text-deep-purple border-b border-neutral-200 pb-3">
            {group.year}
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {group.periods.map((period) => (
              <div class="rounded-2xl border border-neutral-200 bg-white p-6 space-y-4">
                <h3 class="font-display text-lg font-semibold text-deep-purple">{period.label}</h3>
                <div class="flex flex-col gap-2.5">
                  {period.links.map((l) => (
                    <a
                      href={l.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center justify-between text-sm font-medium text-purple hover:text-deep-purple transition-colors py-1 border-b border-neutral-100"
                    >
                      <span>{l.title}</span>
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <line x1="7" y1="17" x2="17" y2="7"></line>
                        <polyline points="7 7 17 7 17 17"></polyline>
                      </svg>
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <LetsConnect />
</BaseLayout>
