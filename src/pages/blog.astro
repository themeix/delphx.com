---
import BaseLayout from '../layouts/BaseLayout.astro';
import LetsConnect from '../components/LetsConnect.astro';
---

<BaseLayout
  title="Blog | DelphX Capital Markets"
  description="Media & Insights from DelphX Capital Markets Inc."
  canonicalPath="/blog"
>
  <section class="bg-off-white pt-16 sm:pt-24 pb-20">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12 space-y-10">
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <img src="/images/68121fa3c12b45a8493f881a_Quad.svg" alt="" width="24" height="24" class="w-6 h-6" />
          <span class="font-sans font-medium text-xs uppercase tracking-widest text-purple">Insights</span>
        </div>
        <h1 class="font-display text-4xl sm:text-6xl font-bold text-deep-purple tracking-tight">
          Media &amp; Insights
        </h1>
      </div>

      <div class="rounded-2xl overflow-hidden border border-neutral-200 max-h-[460px]">
        <img
          src="/images/68121fa3c12b45a8493f884f_rick-rothenberg-m2LDQGVSBJU-unsplash.avif"
          alt="Media and Insights"
          class="w-full h-full object-cover"
        />
      </div>

      <div class="flex flex-wrap gap-4 pt-2">
        <a
          href="/press-releases"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-deep-purple text-white text-sm font-medium hover:bg-purple transition-colors"
        >
          <span>Explore Press Releases</span>
        </a>
        <a
          href="/resources"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-neutral-300 bg-white text-deep-purple text-sm font-medium hover:border-purple transition-colors"
        >
          <span>Podcasts &amp; Media Appearances</span>
        </a>
      </div>
    </div>
  </section>

  <LetsConnect />
</BaseLayout>
