---
import BaseLayout from '../layouts/BaseLayout.astro';
import LetsConnect from '../components/LetsConnect.astro';

const processSteps = [
  {
    num: '01',
    title: 'Discovery & Structuring',
    desc: 'We begin with a strategic review of your bond portfolio to assess downgrade exposure and define CRS structuring opportunities.',
  },
  {
    num: '02',
    title: 'Product Customization',
    desc: 'We tailor Credit Rating Securities to match your credit risk profile, leveraging your reference bonds and our compliant framework.',
  },
  {
    num: '03',
    title: 'Execution & Custody',
    desc: 'Securities are placed through Delphx Services Corp. and administered via US Bank, ensuring secure, transparent settlement.',
  },
  {
    num: '04',
    title: 'Settlement & Reporting',
    desc: 'We provide post-transaction monitoring and visibility through Bloomberg systems, with ongoing performance tracking.',
  },
];

const pillars = [
  {
    icon: '/images/68121fa3c12b45a8493f8817_square-stretch2.svg',
    title: 'Eliminating counterparty risk',
    desc: 'Provides a standardized facility to issue recognized and transparent securities fully collateralized by US Treasuries, eliminating counterparty risk.',
  },
  {
    icon: '/images/68121fa3c12b45a8493f8816_dot-multi.svg',
    title: 'Expanding access',
    desc: 'Expanding access to those who do not participate in swaps and derivatives, while also giving existing participants who are seeking risk protection / speculation a cost-efficient alternative to CDS.',
  },
  {
    icon: '/images/68121fa3c12b45a8493f8815_leaf-quad.svg',
    title: 'Improved underlying risk profile',
    desc: 'Provides an additional vehicle for yield enhancement with improved underlying risk profiles at lower costs of capitalization – without increasing derivatives exposure.',
  },
  {
    icon: '/images/68121fa3c12b45a8493f8818_circle-con4.svg',
    title: 'Conjunction with existing credit products',
    desc: 'A novel and enhanced product that can be used in conjunction with existing credit products and strategies.',
  },
];

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'FinancialService',
  name: 'DelphX Capital Markets Inc.',
  url: 'https://www.delphx.com',
  description:
    'With the conventional system in crisis, the DelphX market gives institutional investors a new way to hedge credit default risk while achieving enhanced yields and lower cost of protection.',
  areaServed: ['US', 'CA'],
  tickerSymbol: 'TSXV: DELX | OTCQB: DPXCF',
};
---

<BaseLayout
  title="Delphx - Building a better credit market through risk-diffusion"
  description="With the conventional system in crisis, the DelphX market gives institutional investors a new way to hedge credit default risk while achieving enhanced yields and lower cost of protection."
  canonicalPath=""
  schema={homeSchema}
>
  <!-- Hero Section (Sticky with Webflow-style scroll parallax & overlap) -->
  <section id="Hero" class="sticky top-[76px] md:top-[84px] z-0 min-h-[calc(100svh-76px)] md:min-h-[calc(100svh-84px)] flex flex-col justify-between bg-deep-purple text-white overflow-hidden">
    <div class="header-image-wrapper absolute inset-0 overflow-hidden pointer-events-none">
      <img
        id="hero-parallax-img"
        src="/images/68121fa3c12b45a8493f885f_martin-martz-SIhcZYEwMB0-unsplash-1-.jpg"
        alt="Architectural geometric structure representing capital protection"
        fetchpriority="high"
        class="w-full h-full object-cover will-change-transform"
        style="transform: translate3d(0px, 0%, 0px) scale3d(1, 1, 1); transform-style: preserve-3d;"
      />
      <div class="hero-image-overlay absolute inset-0 bg-[#000000]/45"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-deep-purple/60 via-deep-purple/35 to-deep-purple/85"></div>
    </div>

    <div id="hero-content" class="relative z-10 max-w-[1440px] w-full mx-auto px-4 sm:px-8 lg:px-12 pt-12 sm:pt-16 lg:pt-20 pb-10 flex-grow flex flex-col justify-between will-change-transform">
      <div class="space-y-8 lg:space-y-10 my-auto">
        <div data-hero-item class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full border border-white/20 bg-white/10 backdrop-blur-md font-sans font-medium text-xs uppercase tracking-[0.2em] text-lavender">
          <span class="w-1.5 h-1.5 rounded-full bg-lavender"></span>
          <span>TSXV: DELX • OTCQB: DPXCF</span>
        </div>

        <h1 data-hero-item class="font-display text-4xl sm:text-6xl md:text-7xl lg:text-[5.25rem] xl:text-[6rem] font-bold tracking-tight leading-[1.02] text-white uppercase max-w-6xl">
          PROTECTED CAPITAL ATTRACTS CAPITAL
        </h1>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-end pt-2">
          <div data-hero-item class="lg:col-span-7 space-y-6">
            <p class="text-lg sm:text-xl md:text-2xl text-white/85 max-w-2xl leading-relaxed font-light">
              Driving innovation in <strong class="font-semibold text-white">structured credit, private placements, and structured products for crypto currency.</strong> DCM is a <strong class="font-semibold text-white">publicly traded fintech leader</strong> redefining risk, transparency, and growth for global investors.
            </p>

            <div>
              <a
                href="/about"
                class="group inline-flex items-center gap-3 px-7 py-3.5 rounded-full bg-white text-deep-purple font-medium text-sm sm:text-base hover:bg-lavender transition-colors shadow-lg"
              >
                <span>Discover DelphX</span>
                <svg
                  class="w-4 h-4 group-hover:translate-x-1 transition-transform"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>

          <!-- Institutional Highlights Strip -->
          <div data-hero-item class="lg:col-span-5 grid grid-cols-3 gap-3">
            <div class="rounded-xl border border-white/15 bg-white/[0.07] backdrop-blur-md p-4">
              <div class="font-sans font-medium text-[11px] uppercase tracking-wider text-lavender">Collateral</div>
              <div class="mt-1 font-display text-sm sm:text-base font-semibold text-white">US Treasuries</div>
            </div>
            <div class="rounded-xl border border-white/15 bg-white/[0.07] backdrop-blur-md p-4">
              <div class="font-sans font-medium text-[11px] uppercase tracking-wider text-lavender">Structure</div>
              <div class="mt-1 font-display text-sm sm:text-base font-semibold text-white">144A Securities</div>
            </div>
            <div class="rounded-xl border border-white/15 bg-white/[0.07] backdrop-blur-md p-4">
              <div class="font-sans font-medium text-[11px] uppercase tracking-wider text-lavender">Reporting</div>
              <div class="mt-1 font-display text-sm sm:text-base font-semibold text-white">Bloomberg</div>
            </div>
          </div>
        </div>
      </div>

      <div data-hero-item class="pt-8 mt-8 flex items-center justify-between border-t border-white/15 font-sans font-medium text-xs sm:text-sm text-white/70">
        <span>2026</span>
        <span>Miami, NY, Toronto</span>
      </div>
    </div>
  </section>

  <!-- Overlap Wrapper (slides over sticky hero on scroll) -->
  <div class="relative z-10 bg-off-white">
  <!-- Introduction Section -->
  <section class="bg-off-white py-20 md:py-28 border-b border-neutral-200">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start reveal">
        <div class="lg:col-span-4">
          <span class="font-sans font-medium text-xs uppercase tracking-widest text-purple">Introduction</span>
        </div>
        <div class="lg:col-span-8 space-y-8">
          <p class="font-display text-2xl sm:text-3xl md:text-4xl font-medium text-deep-purple leading-snug">
            DCM is building a new class of structured products. We are a publicly traded company which has created a fully collateralized hedged crypto currency structured products — offering institutions, corporates, and investors a safe, transparent path to participate in digital assets while preserving value.
          </p>
          <div>
            <a
              href="/about"
              class="group inline-flex items-center gap-3 px-6 py-3 rounded-full bg-deep-purple text-pearl text-sm font-medium hover:bg-purple transition-colors"
            >
              <span>About Us</span>
              <svg
                class="w-4 h-4 group-hover:translate-x-1 transition-transform"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Services Section -->
  <section class="bg-pearl py-20 md:py-28 border-b border-neutral-200">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12 md:mb-16 reveal">
        <div>
          <span class="font-sans font-medium text-xs uppercase tracking-widest text-purple block mb-2">Solutions</span>
          <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-semibold text-deep-purple">
            Core Services
          </h2>
        </div>
      </div>

      <div data-gsap-stagger class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Service 1 -->
        <div class="group relative rounded-2xl overflow-hidden bg-deep-purple text-white min-h-[420px] flex flex-col justify-between p-8 sm:p-10 reveal">
          <img
            src="/images/682968e34650440bc700bfc4_marek-mucha-kqsOIvxuuuM-unsplash.webp"
            alt="Structured Credit Solutions"
            loading="lazy"
            class="absolute inset-0 w-full h-full object-cover opacity-35 group-hover:scale-105 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-deep-purple via-deep-purple/70 to-deep-purple/40"></div>

          <div class="relative z-10 flex items-center justify-between">
            <img
              src="/images/68121fa3c12b45a8493f8819_triangle-quad2.svg"
              alt=""
              width="36"
              height="36"
              loading="lazy"
              class="w-9 h-9"
            />
            <span class="font-sans font-medium text-xs uppercase tracking-widest text-lavender">01</span>
          </div>

          <div class="relative z-10 space-y-4 mt-16">
            <h3 class="font-display text-2xl sm:text-3xl font-semibold text-white">
              Structured Credit Solutions
            </h3>
            <p class="text-white/80 text-base leading-relaxed">
              Credit Rating Securities (CRS) that optimize portfolio returns and allow bond investors to hedge credit rating migration risk.
            </p>
            <div class="pt-2">
              <a
                href="/about"
                class="inline-flex items-center gap-2 text-sm font-medium text-lavender hover:text-white transition-colors"
              >
                <span>Learn More</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Service 2 -->
        <div class="group relative rounded-2xl overflow-hidden bg-deep-purple text-white min-h-[420px] flex flex-col justify-between p-8 sm:p-10 reveal">
          <img
            src="/images/686c901e2da9128237125720_shutterstock_390490534-p-1080.jpg"
            alt="Private Placements"
            loading="lazy"
            class="absolute inset-0 w-full h-full object-cover opacity-35 group-hover:scale-105 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-deep-purple via-deep-purple/70 to-deep-purple/40"></div>

          <div class="relative z-10 flex items-center justify-between">
            <img
              src="/images/68121fa3c12b45a8493f8817_square-stretch2.svg"
              alt=""
              width="36"
              height="36"
              loading="lazy"
              class="w-9 h-9"
            />
            <span class="font-sans font-medium text-xs uppercase tracking-widest text-lavender">02</span>
          </div>

          <div class="relative z-10 space-y-4 mt-16">
            <h3 class="font-display text-2xl sm:text-3xl font-semibold text-white">
              Private Placements
            </h3>
            <p class="text-white/80 text-base leading-relaxed">
              Private Placements services for corporate clients seeking debt, equity, and structured product solutions.
            </p>
            <div class="pt-2">
              <a
                href="/about"
                class="inline-flex items-center gap-2 text-sm font-medium text-lavender hover:text-white transition-colors"
              >
                <span>Learn More</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Institutional Onboarding & CRS Delivery -->
  <section class="bg-deep-purple text-white py-20 md:py-28 relative overflow-hidden">
    <!-- Subtle ambient radial glow -->
    <div class="pointer-events-none absolute -top-40 right-0 w-[600px] h-[600px] rounded-full bg-purple/15 blur-3xl"></div>

    <div class="relative z-10 max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      <!-- Top Split: Heading + Solar System Orbital Graphic -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center mb-16 md:mb-20 reveal">
        <div class="lg:col-span-7 space-y-5">
          <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full border border-white/15 bg-white/5 font-sans font-medium text-xs uppercase tracking-widest text-lavender">
            <span class="w-1.5 h-1.5 rounded-full bg-lavender animate-pulse"></span>
            <span>Our Process</span>
          </div>
          <h2 class="font-display text-3xl sm:text-5xl md:text-6xl font-semibold text-white leading-[1.08]">
            Institutional Onboarding &amp; CRS Delivery
          </h2>
          <p class="text-base sm:text-lg text-white/75 max-w-2xl leading-relaxed">
            A standardized, US Treasury–collateralized framework engineered for institutional fixed income portfolios—from portfolio risk assessment to Bloomberg-tracked settlement.
          </p>
        </div>

        <!-- Solar-System Rotating Orbital Visual -->
        <div class="lg:col-span-5 flex justify-center lg:justify-end">
          <div class="relative w-64 h-64 sm:w-80 sm:h-80 flex items-center justify-center">
            <!-- Outer Orbit Ring (Clockwise) -->
            <div class="absolute inset-0 rounded-full border border-dashed border-lavender/35 animate-orbit-slow">
              <span class="absolute -top-1.5 left-1/2 -translate-x-1/2 w-3 h-3 rounded-full bg-lavender shadow-[0_0_14px_rgba(175,154,255,0.9)]"></span>
              <span class="absolute -bottom-1.5 left-1/2 -translate-x-1/2 w-2 h-2 rounded-full bg-purple"></span>
            </div>

            <!-- Middle Orbit Ring (Counter-Clockwise) -->
            <div class="absolute inset-7 sm:inset-9 rounded-full border border-white/20 animate-orbit-reverse">
              <span class="absolute top-1/2 -left-1.5 -translate-y-1/2 w-2.5 h-2.5 rounded-full bg-white shadow-[0_0_12px_rgba(255,255,255,0.85)]"></span>
              <span class="absolute top-1/2 -right-1.5 -translate-y-1/2 w-2 h-2 rounded-full bg-lavender/80"></span>
            </div>

            <!-- Inner Original SVG Ring (Slow Clockwise) -->
            <img
              src="/images/68121fa3c12b45a8493f8808_SVG.svg"
              alt="DelphX Institutional CRS Architecture"
              width="320"
              height="320"
              loading="lazy"
              class="w-44 h-44 sm:w-56 sm:h-56 object-contain opacity-85 animate-orbit-slow"
            />

            <!-- Center Core -->
            <div class="absolute w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-gradient-to-br from-purple to-deep-purple border border-lavender/50 shadow-[0_0_30px_rgba(125,59,244,0.55)] flex flex-col items-center justify-center">
              <span class="font-display text-sm sm:text-base font-bold tracking-wider text-white">CRS</span>
              <span class="font-sans font-medium text-[9px] uppercase tracking-widest text-lavender/90">144A</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 4-Step Connected Process Pipeline -->
      <div class="relative mb-16 md:mb-20">
        <!-- Connecting line on desktop -->
        <div class="hidden lg:block absolute top-10 left-8 right-8 h-px bg-gradient-to-r from-purple/40 via-lavender/40 to-purple/40"></div>

        <div data-gsap-stagger class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
          {processSteps.map((step) => (
            <div class="group relative rounded-2xl border border-white/12 bg-white/[0.04] backdrop-blur-sm p-7 space-y-4 hover:border-lavender/50 hover:bg-white/[0.09] transition-colors duration-300">
              <div class="flex items-center justify-between">
                <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-purple/25 border border-lavender/40 font-sans font-medium text-xs font-semibold text-lavender group-hover:bg-purple group-hover:text-white transition-colors duration-300">
                  {step.num}
                </span>
                <span class="w-1.5 h-1.5 rounded-full bg-white/25 group-hover:bg-lavender transition-colors duration-300"></span>
              </div>
              <h3 class="font-display text-xl font-semibold text-white">{step.title}</h3>
              <p class="text-sm text-white/75 leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Modern 2x2 Bento Grid for Value Pillars -->
      <div class="space-y-6">
        <div class="flex items-center gap-3">
          <span class="font-sans font-medium text-xs uppercase tracking-widest text-lavender">Key Advantages</span>
          <span class="h-px flex-grow bg-white/10"></span>
        </div>

        <div data-gsap-stagger class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {pillars.map((pillar, idx) => (
            <div class="group rounded-2xl border border-white/12 bg-white/[0.04] p-7 sm:p-8 flex flex-col sm:flex-row gap-5 items-start hover:border-lavender/50 hover:bg-white/[0.08] transition-colors duration-300">
              <div class="w-12 h-12 rounded-xl bg-purple/20 border border-lavender/30 flex items-center justify-center shrink-0 p-2.5">
                <img src={pillar.icon} alt="" width="32" height="32" loading="lazy" class="w-full h-full object-contain invert" />
              </div>
              <div class="space-y-2">
                <div class="flex items-center gap-2">
                  <span class="font-sans font-medium text-[11px] text-lavender/75">0{idx + 1}</span>
                  <h3 class="font-display text-xl font-semibold text-white group-hover:text-lavender transition-colors duration-300">
                    {pillar.title}
                  </h3>
                </div>
                <p class="text-sm sm:text-base text-white/75 leading-relaxed">{pillar.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <LetsConnect />
  </div>
</BaseLayout>
