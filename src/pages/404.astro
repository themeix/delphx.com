---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Not Found | DelphX Capital Markets"
  description="We're sorry, but the page you're looking for doesn't exist."
  noindex={true}
>
  <section class="relative min-h-[calc(100svh-68px)] flex items-center justify-center bg-deep-purple text-white overflow-hidden">
    <img
      src="/images/68121fa3c12b45a8493f885f_martin-martz-SIhcZYEwMB0-unsplash-1-.jpg"
      alt=""
      class="absolute inset-0 w-full h-full object-cover opacity-35"
    />
    <div class="absolute inset-0 bg-deep-purple/70"></div>

    <div class="relative z-10 max-w-xl mx-auto px-4 text-center space-y-6">
      <div class="font-sans font-medium text-xs uppercase tracking-widest text-lavender">Page Not Found</div>
      <h1 class="font-display text-7xl sm:text-9xl font-bold text-white">404</h1>
      <p class="text-base sm:text-lg text-white/80 leading-relaxed">
        We're sorry, but the page you're looking for doesn't exist. It might have been moved, deleted, or perhaps it never existed at all.
      </p>
      <div class="pt-2">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-white text-deep-purple font-medium text-sm hover:bg-lavender transition-colors"
        >
          <span>Home</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
