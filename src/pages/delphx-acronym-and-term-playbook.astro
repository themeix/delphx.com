---
import BaseLayout from '../layouts/BaseLayout.astro';
import LetsConnect from '../components/LetsConnect.astro';

const terms = [
  {
    term: 'CPO',
    definition: 'Collateralized Put Option - a fully-collateralized 144A security which provides protection against default of a referenced Bond.',
  },
  {
    term: 'CRN',
    definition: 'Collateralized Reference Note - a 144A security which provides collateral for amount being covered in the CPO in return for a premium paid by the CPO.',
  },
  {
    term: 'CDS',
    definition: 'Credit Default Swap - a derivative which provides protection against default of a referenced Bond or entity.',
  },
  {
    term: 'CUSIP',
    definition: 'Committee on Uniform Security Identification Procedures - a nine-digit numeric or nine-character alphanumeric code that identifies a North American financial security.',
  },
  {
    term: 'ISDA',
    definition: 'International Swaps and Derivatives Association - Determine whether a reference entity has defaulted on their debt obligations and sets an auction which in turn dictates any recovery values.',
  },
  {
    term: 'Recovery Value',
    definition: 'The amount of value in a Bond when the issuer of that Bond defaults.',
  },
  {
    term: '144A',
    definition: 'Security Securities which are privately placed to qualified institutional investors.',
  },
  {
    term: 'SEC',
    definition: 'Securities & Exchange Commission.',
  },
];
---

<BaseLayout
  title="DelphX Acronym and Term Playbook | DelphX Capital Markets"
  description="Glossary of structured credit and fixed income acronyms and terms used by DelphX Capital Markets: CPO, CRN, CDS, CUSIP, ISDA, Recovery Value, 144A, and SEC."
  canonicalPath="/delphx-acronym-and-term-playbook"
>
  <section class="bg-off-white pt-16 sm:pt-24 pb-16 border-b border-neutral-200">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      <div class="flex items-center gap-3 mb-6">
        <img src="/images/68121fa3c12b45a8493f881a_Quad.svg" alt="" width="24" height="24" class="w-6 h-6" />
        <span class="font-mono text-xs uppercase tracking-widest text-purple">Glossary</span>
      </div>
      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl font-bold text-deep-purple tracking-tight max-w-4xl">
        DelphX Acronym and Term Playbook
      </h1>
      <p class="mt-5 text-lg text-neutral-600 max-w-3xl">
        The following is a list of Acronyms &amp; Terms that will be helpful to anyone reading this presentation:
      </p>
    </div>
  </section>

  <section class="bg-off-white py-16 md:py-24">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-4">
          <div class="rounded-2xl overflow-hidden border border-neutral-200">
            <img
              src="/images/68121fa3c12b45a8493f8851_pexels-kindelmedia-6773515.webp"
              alt="DelphX Acronym and Term Playbook"
              class="w-full h-auto object-cover"
            />
          </div>
        </div>

        <div class="lg:col-span-8 divide-y divide-neutral-200 border-t border-b border-neutral-200">
          {terms.map((item) => (
            <div class="py-6 grid grid-cols-1 sm:grid-cols-12 gap-3 sm:gap-6">
              <div class="sm:col-span-4">
                <h2 class="font-display text-xl font-bold text-deep-purple">{item.term}</h2>
              </div>
              <div class="sm:col-span-8">
                <p class="text-neutral-700 text-base leading-relaxed">{item.definition}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <LetsConnect />
</BaseLayout>
