---
import BaseLayout from '../layouts/BaseLayout.astro';
import LetsConnect from '../components/LetsConnect.astro';
import teamMembers from '../data/team.json';
---

<BaseLayout
  title="Team | DelphX Capital Markets"
  description="Meet the leadership team at DelphX Capital Markets Inc. driving structured credit and private placement innovation."
  canonicalPath="/team"
>
  <section class="bg-off-white pt-16 sm:pt-24 pb-16 border-b border-neutral-200">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      <div class="flex items-center gap-3 mb-6">
        <img src="/images/68121fa3c12b45a8493f881a_Quad.svg" alt="" width="24" height="24" class="w-6 h-6" />
        <span class="font-mono text-xs uppercase tracking-widest text-purple">Leadership</span>
      </div>
      <h1 class="font-display text-4xl sm:text-6xl md:text-7xl font-bold text-deep-purple tracking-tight">
        Our Team
      </h1>
    </div>
  </section>

  <section class="bg-off-white py-16 md:py-24">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {teamMembers.map((member) => (
          <a
            href={`/team/${member.slug}`}
            class="group rounded-2xl border border-neutral-200 bg-white overflow-hidden flex flex-col justify-between hover:border-purple hover:shadow-md transition-all"
          >
            <div class="aspect-[4/3] bg-deep-purple relative overflow-hidden flex items-center justify-center">
              {member.image ? (
                <img
                  src={member.image}
                  alt={member.name}
                  loading="lazy"
                  class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
                />
              ) : (
                <div class="w-24 h-24 rounded-full bg-white/10 border border-lavender/30 flex items-center justify-center font-display text-3xl font-bold text-lavender">
                  {member.initials}
                </div>
              )}
            </div>

            <div class="p-7 flex items-end justify-between gap-4">
              <div>
                <h2 class="font-display text-2xl font-semibold text-deep-purple group-hover:text-purple transition-colors">
                  {member.name}
                </h2>
                <p class="mt-1 text-sm text-neutral-600">{member.role}</p>
                <div class="mt-4 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-purple">
                  <span>Read Bio</span>
                  <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <LetsConnect />
</BaseLayout>
