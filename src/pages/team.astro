---
import BaseLayout from '../layouts/BaseLayout.astro';
import LetsConnect from '../components/LetsConnect.astro';
import teamMembers from '../data/team.json';
---

<BaseLayout
  title="Team | DelphX Capital Markets"
  description="Meet the leadership team at DelphX Capital Markets Inc. driving structured credit and private placement innovation."
  canonicalPath="/team"
>
  <section class="bg-off-white pt-12 sm:pt-16 pb-12 sm:pb-16 border-b border-neutral-200">
    <div data-page-header class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      <div class="flex items-center gap-3 mb-6">
        <img src="/images/68121fa3c12b45a8493f881a_Quad.svg" alt="" width="24" height="24" class="w-6 h-6" />
        <span class="font-sans font-medium text-xs uppercase tracking-widest text-purple">Leadership</span>
      </div>
      <h1 class="font-display text-4xl sm:text-6xl md:text-7xl font-bold text-deep-purple tracking-tight">
        Our Team
      </h1>
    </div>
  </section>

  <section class="bg-off-white py-16 md:py-24">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      <div data-gsap-stagger class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {teamMembers.map((member, idx) => (
          <a
            href={`/team/${member.slug}`}
            class="group rounded-2xl border border-neutral-200 bg-white p-8 flex flex-col justify-between gap-10 hover:border-purple hover:shadow-md transition-all"
          >
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="font-sans font-medium text-xs text-purple tracking-widest">0{idx + 1}</span>
                <span class="w-2 h-2 rounded-full bg-neutral-200 group-hover:bg-purple transition-colors"></span>
              </div>
              <div>
                <h2 class="font-display text-2xl sm:text-3xl font-semibold text-deep-purple group-hover:text-purple transition-colors">
                  {member.name}
                </h2>
                <p class="mt-2 text-sm sm:text-base text-neutral-600">{member.role}</p>
              </div>
            </div>

            <div class="pt-5 border-t border-neutral-100 flex items-center justify-between font-sans font-medium text-xs uppercase tracking-wider text-neutral-500 group-hover:text-purple transition-colors">
              <span>Read Bio</span>
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <LetsConnect />
</BaseLayout>
