---
import BaseLayout from '../layouts/BaseLayout.astro';
import LetsConnect from '../components/LetsConnect.astro';
import legal from '../data/legal.json';

const page = legal['privacy-policy'];
---

<BaseLayout
  title={`${page.title} | DelphX Capital Markets`}
  description="Privacy Policy for DelphX Capital Markets Inc."
  canonicalPath="/privacy-policy"
>
  <section class="bg-off-white pt-16 sm:pt-24 pb-12 border-b border-neutral-200">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      <div class="font-sans font-medium text-xs uppercase tracking-widest text-purple mb-4">Legal</div>
      <h1 class="font-display text-4xl sm:text-6xl font-bold text-deep-purple tracking-tight">
        Privacy Policy
      </h1>
    </div>
  </section>

  <section class="bg-off-white py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-8">
      <div class="rich-text" set:html={page.html} />
    </div>
  </section>

  <LetsConnect compact />
</BaseLayout>
