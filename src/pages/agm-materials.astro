---
// Fallback redirect for environments without .htaccess (e.g. local Astro dev/preview).
// Production Apache/LiteSpeed also serves a 301 redirect via public/.htaccess.
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting to AGM Materials | DelphX Capital Markets</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href="https://www.delphx.com/agm" />
    <meta http-equiv="refresh" content="0;url=/agm" />
    <script is:inline>
      window.location.replace('/agm');
    </script>
  </head>
  <body>
    <p>Redirecting to <a href="/agm">/agm</a>...</p>
  </body>
</html>
