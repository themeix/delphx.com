---
import BaseLayout from '../layouts/BaseLayout.astro';
import LetsConnect from '../components/LetsConnect.astro';

const dimensions = [
  {
    icon: '/images/68b830517320cb16662f6beb_Icon-53-.svg',
    title: 'Structured Credit',
    desc: 'Structured Credit through Credit Rating Securities (CRS) helping investors manage credit risk while optimizing portfolio returns.',
  },
  {
    icon: '/images/68b830517320cb16662f6be9_Icon-54-.svg',
    title: 'Private Placement Advisory',
    desc: 'Private Placement Advisory for mid-market corporates and institutions, offering tailored debt, equity, and structured capital solutions backed by broker-dealer capability.',
  },
  {
    icon: '/images/68b830517320cb16662f6bec_Icon-55-.svg',
    title: 'Structured Product Solution for Crypto Currency (QCS)',
    desc: 'A fully collateralized, risk-managed structured product solutions for crypto currency for unmatched downside protection.',
  },
];

const storyKeys = [
  'We close the gap between inefficient credit risk transfer and limited institutional access to alternative capital—with structured products and private placement services built for transparency and control.',
  'Our instruments solve legacy derivatives challenges—eliminating counterparty risk, enhancing transparency, and delivering real economic utility in both traditional and digital asset environments.',
  'Credit cycles shift. Credit risk endures. Our tools are purpose-designed to withstand varied market regimes and provide reliable risk management where traditional options may fail.',
  'We are not a high-frequency trader or software vendor. We are market-driven, capital markets architects, delivering structured solutions through purpose-built vehicles backed by regulatory alignment.',
  'Designed with top-tier dealers, legal specialists, and market practitioners—our products are proven to meet real-world needs and regulatory benchmarks.',
  'We serve both institutional investors seeking risk management and corporations seeking capital—with tools calibrated for depth, flexibility, and scalability.',
];

const metrics = [
  {
    value: '$18,777,622',
    label: 'Market Capitalization & Capital Base',
    svg: '/images/68121fa3c12b45a8493f881c_Bar_Graph.svg',
  },
  {
    value: '199,000,000',
    label: 'Shares & Market Reach',
    svg: '/images/68121fa3c12b45a8493f881b_DotGraph.svg',
  },
  {
    value: '$15.7 Trillion',
    label: 'Addressable Global Bond & Credit Market',
    svg: '/images/68121fa3c12b45a8493f881d_Chart.svg',
  },
];
---

<BaseLayout
  title="About Delphx Capital Markets"
  description="At DelphX, we are focused on optimizing fixed income portfolio returns through Credit Rating Securities and supporting corporate clients with bespoke private placements."
  canonicalPath="/about"
>
  <!-- Page Header -->
  <section class="bg-off-white pt-12 sm:pt-16 pb-12 sm:pb-16 border-b border-neutral-200">
    <div data-page-header class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      <div class="flex items-center gap-3 mb-6">
        <img src="/images/68121fa3c12b45a8493f881a_Quad.svg" alt="" width="24" height="24" class="w-6 h-6" />
        <span class="font-mono text-xs uppercase tracking-widest text-purple">About Us</span>
      </div>
      <h1 class="font-display text-4xl sm:text-6xl md:text-7xl font-bold text-deep-purple tracking-tight max-w-4xl">
        Delphx Capital Markets
      </h1>
      <p class="mt-6 text-lg sm:text-2xl text-neutral-600 max-w-3xl leading-relaxed">
        At DelphX, we are focused on optimizing fixed income portfolio returns through Credit Rating Securities and supporting corporate clients with bespoke private placements.
      </p>
    </div>
  </section>

  <!-- Three Dimensions (Parallax Architectural Image + White Typography) -->
  <section class="relative py-20 md:py-28 bg-deep-purple text-white overflow-hidden">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <img
        data-parallax-img
        src="/images/68121fa3c12b45a8493f885f_martin-martz-SIhcZYEwMB0-unsplash-1-.jpg"
        alt="DelphX Capital Markets architecture"
        class="w-full h-full object-cover opacity-45 will-change-transform"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-deep-purple/80 via-deep-purple/65 to-deep-purple/90"></div>
    </div>

    <div class="relative z-10 max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      <div class="max-w-3xl mb-14 reveal">
        <span class="font-mono text-xs uppercase tracking-widest text-lavender block mb-3">Our Capabilities</span>
        <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-semibold text-white leading-tight">
          At DelphX Capital Markets, we deliver innovative solutions across three dimensions
        </h2>
      </div>

      <div data-gsap-stagger class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {dimensions.map((item, idx) => (
          <div class="group rounded-2xl border border-white/15 bg-white/[0.08] backdrop-blur-md p-8 space-y-5 hover:border-lavender/50 hover:bg-white/[0.12] transition-colors duration-300">
            <div class="flex items-center justify-between">
              <div class="w-12 h-12 rounded-xl bg-white/15 border border-white/20 flex items-center justify-center p-2.5">
                <img src={item.icon} alt="" width="32" height="32" loading="lazy" class="w-full h-full object-contain invert brightness-200" />
              </div>
              <span class="font-mono text-xs text-lavender/80">0{idx + 1}</span>
            </div>
            <h3 class="font-display text-xl font-semibold text-white">{item.title}</h3>
            <p class="text-white/80 text-sm sm:text-base leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Keys to the Story -->
  <section class="bg-pearl py-20 md:py-28 border-b border-neutral-200">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        <div class="lg:col-span-4 reveal">
          <span class="font-mono text-xs uppercase tracking-widest text-purple block mb-3">Our Thesis</span>
          <h2 class="font-display text-3xl sm:text-4xl font-semibold text-deep-purple">
            Keys to the Story
          </h2>
        </div>

        <div data-gsap-stagger class="lg:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-6">
          {storyKeys.map((text, idx) => (
            <div class="rounded-2xl bg-white border border-neutral-200 p-7 space-y-3 hover:border-purple/50 transition-colors duration-300">
              <div class="font-mono text-xs text-purple">0{idx + 1}</div>
              <p class="text-neutral-700 text-sm sm:text-base leading-relaxed">{text}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Metrics Section -->
  <section class="bg-deep-purple text-white py-20 md:py-28">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      <div data-gsap-stagger class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {metrics.map((m) => (
          <div class="rounded-2xl border border-white/15 bg-white/[0.05] p-8 flex flex-col justify-between gap-8 hover:border-lavender/45 transition-colors duration-300">
            <div>
              <div class="font-display text-3xl sm:text-4xl font-bold text-white">{m.value}</div>
              <div class="mt-2 font-mono text-xs text-lavender uppercase tracking-wider">{m.label}</div>
            </div>
            <img src={m.svg} alt="" loading="lazy" class="w-full h-24 object-contain object-left opacity-90" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <LetsConnect />
</BaseLayout>
