---
import BaseLayout from '../layouts/BaseLayout.astro';
import LetsConnect from '../components/LetsConnect.astro';

const communications = [
  { title: 'Press Releases', href: '/press-releases', external: false },
  { title: 'AGM Materials', href: '/agm', external: false },
  { title: 'Company Financials', href: '/company-financials', external: false },
  {
    title: 'Regulatory Filings',
    href: 'https://sedar.com/DisplayProfile.do?lang=EN&issuerType=03&issuerNo=00042358',
    external: true,
  },
  { title: 'Acronym and Term Playbook', href: '/delphx-acronym-and-term-playbook', external: false },
  {
    title: 'Company Presentation',
    href: '/docs/683c6e2e3ff75c4c7448e8bf_Final-DCM-investor-deck-1.pdf',
    external: true,
  },
  { title: '2026 Annual General and Special Meeting', href: '/agm', external: false },
];

const thesisPoints = [
  'One of a kind solution offering a smarter way to manage credit default risk while removing counterparty risk',
  'Significant early stage opportunity to own “special” and capture a greater share of a very large and growing TAM. (Total addressable market)',
  'Successfully executing a long-term growth strategy focused on our Right to Win',
  'Leveraging our brand awareness with marketing initiatives to drive growth',
  'Planning to deliver strong top and bottom-line operating and financial performance',
  'Agile team, mutually focused on delivering positive business and social impact',
];
---

<BaseLayout
  title="Investors | DelphX Capital Markets"
  description="Investor communications, press releases, AGM materials, company financials, regulatory filings, white paper, and investment thesis for DelphX Capital Markets (TSXV: DELX | OTCQB: DPXCF)."
  canonicalPath="/investors"
>
  <!-- Page Header -->
  <section class="bg-off-white pt-12 sm:pt-16 pb-12 sm:pb-16 border-b border-neutral-200">
    <div data-page-header class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      <div class="flex items-center gap-3 mb-6">
        <img src="/images/68121fa3c12b45a8493f881a_Quad.svg" alt="" width="24" height="24" class="w-6 h-6" />
        <span class="font-mono text-xs uppercase tracking-widest text-purple">TSXV: DELX • OTCQB: DPXCF</span>
      </div>
      <h1 class="font-display text-4xl sm:text-6xl md:text-7xl font-bold text-deep-purple tracking-tight">
        Investors
      </h1>
    </div>
  </section>

  <!-- Investor Communications -->
  <section class="bg-off-white py-16 md:py-24 border-b border-neutral-200">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      <h2 class="font-display text-2xl sm:text-3xl font-semibold text-deep-purple mb-10">
        Investor Communications
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {communications.map((item) => (
          <a
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
            class="group rounded-2xl border border-neutral-200 bg-white p-7 flex items-center justify-between gap-4 hover:border-purple hover:shadow-sm transition-all"
          >
            <h3 class="font-display text-lg sm:text-xl font-medium text-deep-purple group-hover:text-purple transition-colors">
              {item.title}
            </h3>
            <svg
              class="w-5 h-5 text-neutral-400 group-hover:text-purple group-hover:translate-x-1 transition-all shrink-0"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- White Paper & Investor Contact -->
  <section class="bg-pearl py-16 md:py-24 border-b border-neutral-200">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-7 space-y-5">
          <span class="font-mono text-xs uppercase tracking-widest text-purple">Research</span>
          <h2 class="font-display text-3xl sm:text-4xl font-semibold text-deep-purple">White Paper</h2>
          <p class="text-lg text-neutral-700 leading-relaxed">
            Key Characteristics of Delphx’s Private Placement Securities. How They Compare to and Improve Upon Credit Default Swaps.
          </p>
          <div class="pt-2">
            <a
              href="/docs/683c754c61cd08b273d2aec4_Delphx-White-Paper-11-2-23--1-.pdf"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-3 px-6 py-3 rounded-full bg-deep-purple text-white text-sm font-medium hover:bg-purple transition-colors"
            >
              <span>Download White Paper (PDF)</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path d="M12 5v14M5 12l7 7 7-7"></path>
              </svg>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 rounded-2xl bg-white border border-neutral-200 p-8 space-y-3">
          <div class="font-mono text-xs uppercase tracking-widest text-purple">Investor Relations</div>
          <p class="text-neutral-700 text-base leading-relaxed">
            For more information on investor communications, please contact:
          </p>
          <a
            href="mailto:george.wentworth@delphx.com"
            class="inline-block font-display text-lg font-semibold text-deep-purple hover:text-purple transition-colors break-all"
          >
            george.wentworth@delphx.com
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Investment Thesis -->
  <section class="bg-off-white py-20 md:py-28">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 space-y-8">
          <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-semibold text-deep-purple">
            Investment Thesis
          </h2>
          <div class="space-y-4">
            {thesisPoints.map((pt, idx) => (
              <div class="flex items-start gap-4 p-4 rounded-xl bg-white border border-neutral-200">
                <span class="font-mono text-xs text-purple pt-1">0{idx + 1}</span>
                <p class="text-neutral-700 text-base leading-relaxed">{pt}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-2xl overflow-hidden border border-neutral-200 shadow-sm">
            <img
              src="/images/68121fa3c12b45a8493f8841_vackground-com-0F2pC8_DwvM-unsplash.jpg"
              alt="DelphX Investment Thesis"
              loading="lazy"
              class="w-full h-auto object-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <LetsConnect />
</BaseLayout>
